  network_code varchar(64) [not null]
  name varchar(256) [not null]
  network_type varchar(32) [not null]
  configuration_release_id uuid [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, network_id) [pk]
    (tenant_id, network_code, valid_from) [unique]
  }
}

Table network_participation {
  tenant_id uuid [not null]
  network_participation_id uuid [not null]
  network_id uuid [not null]
  pharmacy_id uuid [not null]
