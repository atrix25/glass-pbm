Ref: party.tenant_id > tenant.tenant_id
Ref: party_identifier.(tenant_id, party_id) > party.(tenant_id, party_id)
Ref: agreement.(tenant_id, buyer_party_id) > party.(tenant_id, party_id)
Ref: agreement.(tenant_id, seller_party_id) > party.(tenant_id, party_id)
Ref: agreement.(tenant_id, parent_agreement_id) > agreement.(tenant_id, agreement_id)
Ref: agreement_term.(tenant_id, agreement_id) > agreement.(tenant_id, agreement_id)
Ref: agreement_term.(tenant_id, source_artifact_id) > source_artifact.(tenant_id, source_artifact_id)
Ref: benefit_plan.(tenant_id, sponsor_party_id) > party.(tenant_id, party_id)
Ref: benefit_plan.(tenant_id, client_agreement_id) > agreement.(tenant_id, agreement_id)
Ref: benefit_plan.(tenant_id, configuration_release_id) > configuration_release.(tenant_id, configuration_release_id)
Ref: benefit_plan.(tenant_id, formulary_id) > formulary.(tenant_id, formulary_id)
Ref: benefit_plan.(tenant_id, network_id) > network.(tenant_id, network_id)
Ref: benefit_rule.(tenant_id, benefit_plan_id) > benefit_plan.(tenant_id, benefit_plan_id)
Ref: person.tenant_id > tenant.tenant_id
Ref: phi.member_identity.(tenant_id, person_id) > person.(tenant_id, person_id)
Ref: member.(tenant_id, person_id) > person.(tenant_id, person_id)
Ref: member.(tenant_id, sponsor_party_id) > party.(tenant_id, party_id)
Ref: member.(tenant_id, subscriber_member_id) > member.(tenant_id, member_id)
Ref: eligibility_file.(tenant_id, sponsor_party_id) > party.(tenant_id, party_id)
Ref: eligibility_event.(tenant_id, eligibility_file_id) > eligibility_file.(tenant_id, eligibility_file_id)
Ref: eligibility_event.(tenant_id, member_id) > member.(tenant_id, member_id)
Ref: eligibility_event.(tenant_id, benefit_plan_id) > benefit_plan.(tenant_id, benefit_plan_id)
Ref: eligibility_span.(tenant_id, member_id) > member.(tenant_id, member_id)
Ref: eligibility_span.(tenant_id, benefit_plan_id) > benefit_plan.(tenant_id, benefit_plan_id)
Ref: eligibility_span.(tenant_id, source_event_id) > eligibility_event.(tenant_id, eligibility_event_id)
Ref: formulary.(tenant_id, configuration_release_id) > configuration_release.(tenant_id, configuration_release_id)
Ref: formulary_coverage.(tenant_id, formulary_id) > formulary.(tenant_id, formulary_id)
Ref: formulary_coverage.drug_product_id > drug_product.drug_product_id
Ref: pharmacy.(tenant_id, party_id) > party.(tenant_id, party_id)
Ref: network.(tenant_id, configuration_release_id) > configuration_release.(tenant_id, configuration_release_id)
Ref: network_participation.(tenant_id, network_id) > network.(tenant_id, network_id)
Ref: network_participation.(tenant_id, pharmacy_id) > pharmacy.(tenant_id, pharmacy_id)
