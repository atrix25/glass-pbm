    (tenant_id, member_id, observed_at)
  }
}

Table rebate_agreement {
  tenant_id uuid [not null]
  rebate_agreement_id uuid [not null]
  agreement_id uuid [not null]
  manufacturer_party_id uuid [not null]
  contracting_party_id uuid [not null]
  client_agreement_id uuid
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, rebate_agreement_id) [pk]
  }
}

Table rebate_term {
  tenant_id uuid [not null]
  rebate_term_id uuid [not null]
  rebate_agreement_id uuid [not null]
  remuneration_type varchar(48) [not null]
  scope_json jsonb [not null]
  calculation_basis varchar(32) [not null]
  rate decimal(18,9)
  flat_amount bigint [note: 'ISO-4217 minor units']
  currency char(3)
  pass_through_rate decimal(18,9) [not null, note: 'Glass offering requires 1.000000000; separate service fees cannot reduce entitlement']
  source_artifact_id uuid
  source_locator varchar(256)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, rebate_term_id) [pk]
    (tenant_id, rebate_agreement_id, remuneration_type, valid_from)
  }
}

