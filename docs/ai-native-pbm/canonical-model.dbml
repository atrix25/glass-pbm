  tier_code varchar(16) [not null]
  coverage_status varchar(24) [not null]
  prior_auth_required boolean [not null]
  step_therapy_required boolean [not null]
  quantity_limit_json jsonb
  channel_restriction_json jsonb
  criteria_set_id uuid
  source_artifact_id uuid
  source_locator varchar(256)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
