  source_artifact_id uuid [not null]
  engine_version varchar(64) [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, criteria_set_id) [pk]
    (tenant_id, criteria_code, valid_from, recorded_at) [unique]
  }
}

Table utilization_management_case {
  tenant_id uuid [not null]
  um_case_id uuid [not null]
  case_number varchar(128) [not null]
  member_id uuid [not null]
  drug_product_id uuid
  criteria_set_id uuid
  request_type varchar(32) [not null]
