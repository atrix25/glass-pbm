  gross_amount bigint [not null, note: 'ISO-4217 minor units']
  client_amount bigint [not null, note: 'ISO-4217 minor units']
  retained_amount bigint [not null, note: 'ISO-4217 minor units; must be zero for Glass; client_amount must equal gross_amount']
  currency char(3) [not null]
  accrual_period varchar(16) [not null]
  idempotency_key varchar(256) [not null]
  reverses_event_id uuid
  recorded_at timestamp [not null]

  Indexes {
