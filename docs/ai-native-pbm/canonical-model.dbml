Project ai_native_pbm {
  database_type: "PostgreSQL"
  Note: '''
  Target logical model for a commercial-first, full-service, multi-tenant PBM.
  This is not a migration. Tenant-owned identifiers are unique only with tenant_id.
  Effective time uses valid_from/valid_to; system time uses recorded_at/superseded_at.
  Facts marked append-only are corrected with compensating or superseding facts.
  Posted money uses bigint ISO-4217 minor units; rates use decimal(18,9), unit prices
  decimal(19,9), and quantities decimal(24,9). Provisional values round before posting.
  '''
}

Enum tenant_status {
  provisioning
  active
  suspended
  closed
}

Enum fact_status {
  pending
  accepted
  rejected
  reversed
  void
}

Enum work_status {
  queued
  assigned
  in_progress
  waiting
  completed
  cancelled
}

Enum decision_status {
  proposed
  approved
  denied
  expired
  withdrawn
}

Enum agent_run_status {
  queued
  running
  completed
  escalated
  refused
  failed
  cancelled
}

Enum ledger_side {
  debit
  credit
}

Enum data_classification {
  public
  internal
  confidential
  phi
  restricted
}

Table tenant {
  tenant_id uuid [pk]
  tenant_key varchar(64) [not null, unique]
  legal_name varchar(256) [not null]
  status tenant_status [not null]
  home_region varchar(32) [not null]
  default_currency char(3) [not null, default: 'USD']
  created_at timestamp [not null]
  closed_at timestamp
}

Table party {
  tenant_id uuid [not null]
  party_id uuid [not null]
  party_type varchar(32) [not null, note: 'sponsor, pbm, manufacturer, pharmacy, prescriber, carrier, vendor, regulator, person']
  legal_name varchar(256) [not null]
  tax_id_token varchar(256) [note: 'Token only; clear value belongs in restricted vault']
  external_key varchar(128)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, party_id) [pk]
    (tenant_id, external_key, valid_from) [unique]
    (tenant_id, party_type)
  }
}

Table party_identifier {
  tenant_id uuid [not null]
  party_identifier_id uuid [not null]
  party_id uuid [not null]
  identifier_type varchar(32) [not null, note: 'NPI, NCPDP, EIN_TOKEN, NAIC, internal']
  identifier_value_token varchar(256) [not null]
  issuing_authority varchar(128)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, party_identifier_id) [pk]
    (tenant_id, identifier_type, identifier_value_token, valid_from) [unique]
  }
}

Table agreement {
  tenant_id uuid [not null]
  agreement_id uuid [not null]
  agreement_number varchar(128) [not null]
  agreement_type varchar(32) [not null, note: 'client, pharmacy, manufacturer, vendor, clinical']
  buyer_party_id uuid [not null]
  seller_party_id uuid [not null]
  parent_agreement_id uuid
  commercial_model varchar(32) [not null, note: 'Client agreements: caremark_truecost or caremark_drug_level_rebate; other agreement types: not_applicable. Pricing choice is separate from 100% rebate pass-through.']
  status varchar(24) [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, agreement_id) [pk]
    (tenant_id, agreement_number, valid_from) [unique]
  }
}

Table agreement_term {
  tenant_id uuid [not null]
  agreement_term_id uuid [not null]
  agreement_id uuid [not null]
  term_code varchar(96) [not null]
  scope_json jsonb [not null]
  value_json jsonb [not null]
  source_artifact_id uuid
  source_locator varchar(256)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, agreement_term_id) [pk]
    (tenant_id, agreement_id, term_code, valid_from)
  }
}

Table configuration_release {
  tenant_id uuid [not null]
  configuration_release_id uuid [not null]
  release_name varchar(128) [not null]
  content_hash char(64) [not null]
  schema_version varchar(32) [not null]
  engine_version varchar(64) [not null]
  ruleset_version varchar(64) [not null]
  artifact_uri varchar(512)
  approved_by_principal_id uuid
  approved_at timestamp
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, configuration_release_id) [pk]
    (tenant_id, content_hash) [unique]
  }
}

Table benefit_plan {
  tenant_id uuid [not null]
  benefit_plan_id uuid [not null]
  sponsor_party_id uuid [not null]
  client_agreement_id uuid [not null]
  plan_code varchar(64) [not null]
  plan_name varchar(256) [not null]
  line_of_business varchar(32) [not null, note: 'commercial first; extensible to EGWP/Medicaid']
  funding_type varchar(32) [not null]
  configuration_release_id uuid [not null]
  formulary_id uuid [not null]
  network_id uuid [not null]
  accumulator_period_rule varchar(64) [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, benefit_plan_id) [pk]
    (tenant_id, plan_code, valid_from) [unique]
  }
}

Table benefit_rule {
  tenant_id uuid [not null]
  benefit_rule_id uuid [not null]
  benefit_plan_id uuid [not null]
  rule_type varchar(48) [not null, note: 'cost_share, deductible, oop, channel, DAW, exclusion']
  priority int [not null]
  predicate_json jsonb [not null]
  outcome_json jsonb [not null]
  source_artifact_id uuid
  source_locator varchar(256)
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, benefit_rule_id) [pk]
    (tenant_id, benefit_plan_id, rule_type, priority, valid_from) [unique]
  }
}

Table person {
  tenant_id uuid [not null]
  person_id uuid [not null]
  person_token varchar(256) [not null, note: 'Stable pseudonymous join key; no direct identifiers']
  year_of_birth smallint
  sex_code varchar(16)
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, person_id) [pk]
    (tenant_id, person_token) [unique]
  }
}

Table phi.member_identity {
  tenant_id uuid [not null]
  person_id uuid [not null]
  encrypted_payload bytea [not null, note: 'Name, full DOB, address, phone, email']
  key_reference varchar(256) [not null]
  payload_hash char(64) [not null]
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, person_id, recorded_at) [pk]
  }
}

Table member {
  tenant_id uuid [not null]
  member_id uuid [not null]
  person_id uuid [not null]
  sponsor_party_id uuid [not null]
  subscriber_member_id uuid
  cardholder_token varchar(256) [not null]
  person_code varchar(8) [not null]
  relationship_code varchar(8) [not null]
  member_status varchar(24) [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, member_id) [pk]
    (tenant_id, cardholder_token, person_code, valid_from) [unique]
  }
}

Table eligibility_file {
  tenant_id uuid [not null]
  eligibility_file_id uuid [not null]
  sponsor_party_id uuid [not null]
  control_number varchar(128) [not null]
  file_type varchar(24) [not null]
  content_hash char(64) [not null]
  object_uri varchar(512) [not null]
  created_at timestamp [not null]
  received_at timestamp [not null]
  processed_at timestamp
  status fact_status [not null]

  Indexes {
    (tenant_id, eligibility_file_id) [pk]
    (tenant_id, sponsor_party_id, control_number) [unique]
    (tenant_id, content_hash) [unique]
  }
}

Table eligibility_event {
  tenant_id uuid [not null]
  eligibility_event_id uuid [not null]
  eligibility_file_id uuid [not null]
  source_record_key varchar(128) [not null]
  member_id uuid
  benefit_plan_id uuid
  event_type varchar(24) [not null, note: 'add, change, terminate, reinstate, reject']
  coverage_tier varchar(32)
  coverage_valid_from timestamp
  coverage_valid_to timestamp
  status fact_status [not null]
  reason_code varchar(32)
  payload_hash char(64) [not null]
  recorded_at timestamp [not null]
  supersedes_event_id uuid

  Indexes {
    (tenant_id, eligibility_event_id) [pk]
    (tenant_id, eligibility_file_id, source_record_key) [unique]
    (tenant_id, member_id, recorded_at)
  }
}

Table eligibility_span {
  tenant_id uuid [not null]
  eligibility_span_id uuid [not null]
  member_id uuid [not null]
  benefit_plan_id uuid [not null]
  source_event_id uuid [not null]
  coverage_tier varchar(32) [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, eligibility_span_id) [pk]
    (tenant_id, member_id, benefit_plan_id, valid_from, recorded_at) [unique]
  }
}

Table drug_product {
  drug_product_id uuid [pk]
  ndc11 char(11) [not null, unique]
  rxnorm_cui varchar(32)
  gpi varchar(32)
  label_name varchar(256) [not null]
  generic_name varchar(256)
  dosage_form varchar(64)
  strength varchar(64)
  route varchar(32)
  package_size decimal(24,9) [not null]
  unit_of_measure varchar(16) [not null]
  multi_source_code varchar(8)
  therapeutic_class varchar(128)
  is_specialty boolean [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp
}

Table formulary {
  tenant_id uuid [not null]
  formulary_id uuid [not null]
  formulary_code varchar(64) [not null]
  name varchar(256) [not null]
  version varchar(64) [not null]
  configuration_release_id uuid [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

