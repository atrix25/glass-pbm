  Indexes {
    (tenant_id, formulary_coverage_id) [pk]
    (tenant_id, formulary_id, drug_product_id, valid_from, recorded_at) [unique]
  }
}

Table pharmacy {
  tenant_id uuid [not null]
  pharmacy_id uuid [not null]
  party_id uuid [not null]
  ncpdp_id varchar(16) [not null]
  npi varchar(16)
  pharmacy_type varchar(32) [not null]
  is_340b boolean [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, pharmacy_id) [pk]
    (tenant_id, ncpdp_id, valid_from) [unique]
  }
}

Table network {
  tenant_id uuid [not null]
