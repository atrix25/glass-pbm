  }
}

Table clinical_evidence {
  tenant_id uuid [not null]
  clinical_evidence_id uuid [not null]
  um_case_id uuid [not null]
  evidence_type varchar(32) [not null]
  encrypted_payload bytea
  structured_facts jsonb [not null]
  source_artifact_id uuid
  received_at timestamp [not null]
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, clinical_evidence_id) [pk]
    (tenant_id, um_case_id, received_at)
  }
}

Table clinical_decision {
  tenant_id uuid [not null]
  clinical_decision_id uuid [not null]
