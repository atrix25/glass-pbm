  participation_status varchar(24) [not null]
  reimbursement_schedule_id uuid [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, network_participation_id) [pk]
    (tenant_id, network_id, pharmacy_id, valid_from, recorded_at) [unique]
  }
}

Table reimbursement_schedule {
  tenant_id uuid [not null]
  reimbursement_schedule_id uuid [not null]
  agreement_id uuid [not null]
  side varchar(16) [not null, note: 'pharmacy or client']
  line_of_business varchar(32) [not null]
  channel varchar(24) [not null]
  drug_class varchar(24) [not null]
  formula_json jsonb [not null, note: 'Ordered lesser-of arms, discounts, fees, U&C behavior']
  source_artifact_id uuid
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, reimbursement_schedule_id) [pk]
    (tenant_id, agreement_id, side, line_of_business, channel, drug_class, valid_from)
  }
}

Table price_list {
  tenant_id uuid [not null]
  price_list_id uuid [not null]
  price_type varchar(24) [not null, note: 'NADAC, AWP, WAC, MAC, U&C survey']
  owner_party_id uuid
  version varchar(64) [not null]
  content_hash char(64) [not null]
  source_artifact_id uuid
  published_at timestamp
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, price_list_id) [pk]
    (tenant_id, price_type, version) [unique]
    (tenant_id, content_hash) [unique]
  }
}

Table product_price {
  tenant_id uuid [not null]
  product_price_id uuid [not null]
  price_list_id uuid [not null]
  drug_product_id uuid [not null]
  unit_price decimal(19,9) [not null]
  currency char(3) [not null]
  source_product_ndc11 char(11)
  is_simulated boolean [not null]
  valid_from timestamp [not null]
  valid_to timestamp
  recorded_at timestamp [not null]
  superseded_at timestamp

  Indexes {
    (tenant_id, product_price_id) [pk]
    (tenant_id, price_list_id, drug_product_id, valid_from, recorded_at) [unique]
  }
}

Table mac_appeal {
  tenant_id uuid [not null]
  mac_appeal_id uuid [not null]
  pharmacy_id uuid [not null]
  claim_id uuid [not null]
  drug_product_id uuid [not null]
  submitted_at timestamp [not null]
  invoice_unit_price decimal(19,9) [not null]
  applied_mac_unit_price decimal(19,9) [not null]
  status work_status [not null]
  outcome varchar(24)
  determination_due_at timestamp [not null]
  determined_at timestamp
  adjustment_due_at timestamp
  adjusted_at timestamp
  denial_reason varchar(1024)
  cited_ndc11 char(11)
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, mac_appeal_id) [pk]
    (tenant_id, pharmacy_id, submitted_at)
  }
}

Table claim {
  tenant_id uuid [not null]
  claim_id uuid [not null]
  claim_number varchar(128) [not null]
  source_system varchar(64) [not null]
  source_transaction_key varchar(128) [not null]
  idempotency_key varchar(256) [not null]
  transaction_code varchar(8) [not null, note: 'B1, B2, B3']
  reversal_of_claim_id uuid
  member_id uuid [not null]
  eligibility_span_id uuid
  benefit_plan_id uuid [not null]
  pharmacy_id uuid [not null]
  drug_product_id uuid [not null]
  client_agreement_id uuid [not null]
  service_at timestamp [not null]
  submitted_at timestamp [not null]
  adjudicated_at timestamp [not null]
  quantity_dispensed decimal(24,9) [not null]
  days_supply int [not null]
  daw_code varchar(8) [not null]
  channel varchar(24) [not null]
  response_status varchar(16) [not null]
  reject_codes jsonb [not null]
  configuration_release_id uuid [not null]
  engine_version varchar(64) [not null]
  ruleset_version varchar(64) [not null]
  input_hash char(64) [not null]
  output_hash char(64) [not null]
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, claim_id) [pk]
    (tenant_id, claim_number) [unique]
    (tenant_id, source_system, source_transaction_key) [unique]
    (tenant_id, idempotency_key) [unique]
    (tenant_id, member_id, service_at)
  }
}

Table claim_amount {
  tenant_id uuid [not null]
  claim_id uuid [not null]
  amount_type varchar(48) [not null, note: 'submitted, allowed, pharmacy_paid, client_billed, plan_paid, patient_pay, deductible, copay, penalty, benchmark']
  component varchar(48) [not null]
  amount bigint [not null, note: 'ISO-4217 minor units']
  currency char(3) [not null]
  unit_price decimal(19,9)
  price_list_id uuid
  product_price_id uuid

  Indexes {
    (tenant_id, claim_id, amount_type, component) [pk]
  }
}

Table adjudication_trace {
  tenant_id uuid [not null]
  adjudication_trace_id uuid [not null]
  claim_id uuid [not null]
  ordinal int [not null]
  stage varchar(32) [not null]
  rule_id varchar(128) [not null]
  rule_version varchar(64) [not null]
  inputs_hash char(64) [not null]
  inputs_json jsonb [not null]
  output_json jsonb [not null]
  fired boolean [not null]
  source_artifact_id uuid
  source_locator varchar(256)
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, adjudication_trace_id) [pk]
    (tenant_id, claim_id, ordinal) [unique]
  }
}

Table accumulator_account {
  tenant_id uuid [not null]
  accumulator_account_id uuid [not null]
  member_id uuid [not null]
  benefit_plan_id uuid [not null]
  accumulator_type varchar(48) [not null]
  benefit_period_start date [not null]
  benefit_period_end date [not null]
  limit_amount bigint [not null, note: 'ISO-4217 minor units']
  currency char(3) [not null]
  recorded_at timestamp [not null]

  Indexes {
    (tenant_id, accumulator_account_id) [pk]
    (tenant_id, member_id, benefit_plan_id, accumulator_type, benefit_period_start) [unique]
  }
}

Table accumulator_event {
  tenant_id uuid [not null]
  accumulator_event_id uuid [not null]
  accumulator_account_id uuid [not null]
  claim_id uuid
  source_event_id uuid
  event_type varchar(24) [not null, note: 'apply, reverse, transfer, adjustment']
  amount bigint [not null, note: 'Signed append-only delta in ISO-4217 minor units']
  currency char(3) [not null]
  incurred_at timestamp [not null]
  recorded_at timestamp [not null]
  idempotency_key varchar(256) [not null]
  reverses_event_id uuid

  Indexes {
    (tenant_id, accumulator_event_id) [pk]
    (tenant_id, idempotency_key) [unique]
    (tenant_id, accumulator_account_id, incurred_at, recorded_at)
  }
}

Table clinical_criteria_set {
  tenant_id uuid [not null]
  criteria_set_id uuid [not null]
  criteria_code varchar(64) [not null]
  name varchar(256) [not null]
  scope_json jsonb [not null]
